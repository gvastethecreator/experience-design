{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:experience-design:report:1.0",
  "title": "Experience Design report contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "assess",
            "design",
            "experiment",
            "verify",
            "apply"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "created_on": {
          "type": "string",
          "minLength": 1
        },
        "authorized_changes": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "project",
        "scope",
        "mode",
        "language",
        "created_on",
        "authorized_changes",
        "limitations"
      ],
      "additionalProperties": false
    },
    "conclusion": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "proposed",
            "partial",
            "blocked",
            "verified-in-scope"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "render",
              "runtime",
              "participant",
              "analytics",
              "simulation"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "observed_on": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "location",
          "description",
          "observed_on"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "claim_kind": {
            "type": "string",
            "enum": [
              "implementation",
              "visual",
              "interaction",
              "human",
              "data"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "unknown",
              "not-applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "dimension",
          "claim_kind",
          "scope",
          "status",
          "reason",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "hypothesis"
            ]
          },
          "claim_kind": {
            "type": "string",
            "enum": [
              "implementation",
              "visual",
              "interaction",
              "human",
              "data"
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "reach": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "principle_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_test": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "planned",
              "implemented",
              "verified",
              "blocked",
              "dismissed"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "verification_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title",
          "task",
          "state",
          "observation",
          "classification",
          "claim_kind",
          "impact",
          "severity",
          "confidence",
          "reach",
          "evidence_ids",
          "principle_ids",
          "source_ids",
          "proposal",
          "tradeoff",
          "acceptance_test",
          "status",
          "resolution",
          "verification_evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "technical",
              "human"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "measured"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": [
              "number",
              "null"
            ]
          },
          "result": {
            "type": [
              "number",
              "null"
            ]
          },
          "sample_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "population": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "comparison": {
            "type": "boolean"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "status",
          "unit",
          "baseline",
          "result",
          "sample_size",
          "population",
          "method",
          "comparison",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "review_trigger": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question",
          "choice",
          "rationale",
          "alternatives",
          "risk",
          "owner",
          "review_trigger"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "additional_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_on": {
            "type": "string",
            "minLength": 1
          },
          "scope_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "kind",
          "reviewed_on",
          "scope_note"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "session",
    "conclusion",
    "evidence",
    "coverage",
    "findings",
    "metrics",
    "decisions",
    "additional_sources"
  ],
  "additionalProperties": false
}
